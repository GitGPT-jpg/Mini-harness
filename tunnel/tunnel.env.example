# 每个人复制为 ~/.mini-harness/tunnel.env 后按自己的情况填写。
# 真实配置不入库（.gitignore 已忽略 tunnel.env）。

# 堡垒机（必填）：user@host
BASTION=user@10.0.0.1
BASTION_PORT=22

# 本机 SOCKS 端口（各同事可不同，避免冲突）
SOCKS_PORT=1080

# K8s apiserver（可选）：仅当你想额外做一条直连隧道时用，格式 host:6443
# 走 SOCKS 代理时通常不用填。
KUBE_APISERVER=

# 可选：SSH 私钥路径（默认用 ~/.ssh/id_rsa）
SSH_KEY=

# 保活间隔（秒）
KEEPALIVE=30
