# ---- 依赖（各机器 npm install 时重建）----
node_modules/
**/node_modules/

# ---- 生成物 / 本地运行态 ----
# start-hardened.sh 由 postinstall(harden.mjs) 自动生成
pi-web-cockpit/start-hardened.sh
# web-demo 为早期独立探索 demo，不随底座入库
web-demo/
*.log
.DS_Store

# ---- 密钥 / 口令（绝不入库）----
# One API Key 存在 ~/.pi/agent/auth.json（仓库外）；访问口令存在 ~/.pi-web/（仓库外）
*token*
auth.json
*.pem
*.key
# 堡垒机/隧道真实配置（每人一份，不入库）
tunnel.env

# ---- Mac .app 启动器（setup.sh 在本机 Desktop 生成，不入库）----
*.app/
*.icns

# ---- pi-llm-wiki vendor：仅保留源码，剔除 node_modules 与大体积文档素材 ----
pi-web-cockpit/vendor/pi-llm-wiki/node_modules/
pi-web-cockpit/vendor/pi-llm-wiki/assets/

# ---- 运行时产生的会话 / 知识库 / 任务状态（绝不入库）----
# 这些只存在于各自机器的 HOME 下；同事 clone 后是全新状态，看不到任何调试聊天记录
.llm-wiki/
sessions/
*.jsonl
client-state.json
.pi/
.mini-harness/
runs/
inbox/

# ---- 临时 ----
*.bak
.tmp/
tmp/

# 防止工作区测试产生的 validator 被误提交
/validate.py

# 打包产物
/dist/

# ---- 上游 pi-web-ui 源码（v0.111.0 vendored，见 pi-web-ui/PROVENANCE.md）----
# 上游预编译插件产物（约 205MB；精简版将删除相关插件）
pi-web-ui/plugins/office/artifacts/
# 源码构建产物与依赖
pi-web-ui/node_modules/
pi-web-ui/dist/
pi-web-ui/web/dist/
pi-web-ui/plugins/mermaid/vendor/
pi-web-ui/.theme-audit/
